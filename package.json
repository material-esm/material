{
  "name": "material",
  "version": "3.4.8",
  "publishConfig": {
    "access": "public"
  },
  "description": "Material web components",
  "keywords": [
    "material",
    "material design",
    "design system",
    "components",
    "web components",
    "lit"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/material-esm/material.git"
  },
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/material-esm/material/issues"
  },
  "homepage": "https://github.com/material-esm/material#readme",
  "scripts": {
    "start": "npx -y serve",
    "build": "echo 'No build required'",
    "deploy": "wrangler deploy",
    "preview": "wrangler preview",
    "format": "prettier --write ."
  },
  "type": "module",
  "files": [
    "**/*.js",
    "**/*.js.map",
    "**/*.d.ts",
    "**/*.scss",
    "**/*.css",
    "**/*.css.map",
    "!web-test-runner.config.js",
    "!commitlint.config.js",
    "!**/test/**",
    "!**/*_test.*",
    "!.wireit/**",
    "!catalog/",
    "!scripts/",
    "!**/testing/**",
    "testing/harness.{js,js.map,d.ts}",
    "testing/transform-pseudo-classes.{js,js.map,d.ts}"
  ],
  "dependencies": {
    "lit": "^3.3.1"
  },
  "devDependencies": {
    "prettier": "^3.9.8",
    "wrangler": "^4.149.0"
  },
  "prettier": {
    "tabWidth": 2,
    "singleQuote": true,
    "printWidth": 120,
    "semi": false,
    "trailingComma": "all",
    "bracketSameLine": true
  }
}
